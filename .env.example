# Example environment variables for development
NODE_ENV=development
VITE_API_BASE=http://localhost:5000
# When using Vite, env vars intended for client must be prefixed with VITE_
# Copy this to a `.env` or `.env.local` file during development.

# Database - MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=akhil_pune_bhavsar
# Set to true for managed MySQL providers that require TLS.
DB_SSL=false
# Keep certificate verification enabled in production.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10

# JWT Secrets (change these in production)
JWT_SECRET=replace_with_32_plus_random_jwt_secret
SFTP_ENCRYPTION_KEY=replace_with_32_plus_random_encryption_key
REFRESH_SECRET=replace_with_32_plus_random_refresh_secret

# Browser/API security
# Comma-separated exact frontend origins. Do not use * with credentials in production.
CORS_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=lax

# The server refuses to start in production with these defaults.
SUPER_USER_EMAIL=your_admin_email@example.com
SUPER_USER_PASSWORD=replace_with_a_unique_admin_password
SUPER_USER_PHONE=

# SMTP Email Configuration (required for registration success emails)
# Common providers:
# - Gmail App Password (low volume, personal use)
# - Brevo SMTP (free tier available)
# - Mailgun/SendGrid/SES (mostly paid after limits)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_or_app_password
EMAIL_FROM="PCMC Registration <your_email@example.com>"

# Razorpay payment recovery webhook
# In Razorpay Dashboard, create a webhook for `payment.captured` pointing to:
# https://www.akhilpunebhavsarsamaj.in/api/payment/webhook
# Copy its webhook secret below. This is separate from the Razorpay Key Secret.
RAZORPAY_WEBHOOK_SECRET=
